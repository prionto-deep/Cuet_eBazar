# Copy to backend/.env for local development. In production, set these as
# environment variables on your backend host instead of using a file.

# Required. Random string of at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Admin account (created / kept in sync on startup).
# If ADMIN_PASSWORD is set and differs from the stored one, it is rotated.
# Minimum 12 characters. Never commit real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_SHOP_NAME=Prionyx Shop

# Comma-separated extra CORS origins, e.g. your Netlify production URL
# CORS_ORIGINS=https://your-site.netlify.app
